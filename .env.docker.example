# Copiar a .env (no sobrescribir uno existente). Sin secretos reales.
# API_KEY: generar localmente como contenido del archivo siguiente.
API_KEY_SECRET_FILE=./.secrets/api_key
ROUTING_STRATEGY=pro
SEED=7
TURN_SECONDS=2
HTTP_CONCURRENCY=4
PRO_PREDICTION=true
PRO_RESERVATIONS=true
PRO_FLEET=true
WEB_BIND=127.0.0.1
WEB_PORT=8080
# MANTA_DATA_DIR=/service/data y API_KEY_FILE=/run/secrets/api_key se fijan en Compose.
# VITE_DATA_SOURCE=api y VITE_API_BASE_URL=/api se fijan al compilar el frontend.
