# Export manually; this file is not loaded automatically.
API_KEY=choose-a-local-key
ROUTING_STRATEGY=pro
PRO_PREDICTION=true
PRO_RESERVATIONS=true
PRO_FLEET=true
SEED=7
HTTP_CONCURRENCY=4
RISK_WEIGHT=180
REASSIGNMENT_IMPROVEMENT=0.25
VEHICLE_EDGES_PER_TURN=2
MEETING_CANDIDATES=8
PICKUP_CANDIDATES=24
MEETING_MAX_WAIT=8
RESCUE_MIN_BENEFIT=1
RESCUE_RISK_WEIGHT=8
MEETING_RISK_THRESHOLD=0.7
RETREAT_RISK_THRESHOLD=0.7
RETREAT_MIN_IMPROVEMENT=0.25

# Averías físicas opt-in. Probabilidades como fracciones (0..1), reparación en turnos (1..30).
VEHICLE_BREAKDOWNS=false
BREAKDOWN_CHANCE_CAMINANTE=0.25
BREAKDOWN_CHANCE_CORREDOR=0.5
BREAKDOWN_CHANCE_HORDA=0.8
BREAKDOWN_CHANCE_DORMIDO=0.35
REPAIR_TURNS_CAMINANTE=2
REPAIR_TURNS_CORREDOR=3
REPAIR_TURNS_HORDA=5
REPAIR_TURNS_DORMIDO=2
